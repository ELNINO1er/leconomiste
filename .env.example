# Adresse de l'API rédactionnelle.
#
# Sur Hostinger, elle se déclare dans le tableau de bord du site :
# Websites → leconomistedelacotedivoire.com → Environment variables.
#
# `NEXT_PUBLIC_` est nécessaire : la balise de mesure d'audience part du
# navigateur, et une variable sans ce préfixe ne lui parviendrait pas.
#
# Sans valeur, le site vise la production — c'est le cas courant, et ça évite
# qu'un oubli de configuration ne fasse tomber le site en local comme en ligne.
NEXT_PUBLIC_API_BASE_URL=https://admin.leconomistedelacotedivoire.com

# Adresse du back-office, vers laquelle /admin redirige.
#
# En développement, le tableau de bord Angular tourne sur son propre serveur :
#   NEXT_PUBLIC_ADMIN_URL=http://localhost:4500
#
# En ligne, il est servi sous /admin du sous-domaine de l'API — c'est la valeur
# par défaut, il n'y a donc rien à déclarer sur Hostinger.
NEXT_PUBLIC_ADMIN_URL=https://admin.leconomistedelacotedivoire.com/admin/

# Secret partagé avec l'API (SITE_REVALIDATE_SECRET de son côté). Il autorise
# /api/revalidate à vider le cache du site dès qu'un contenu change en
# rédaction. Sans lui, la route répond 503 et le cache expire normalement.
REVALIDATE_SECRET=
